# Frontend Environment Configuration Template

# Local Development
VITE_API_BASE_URL=http://127.0.0.1:5000/api
# Leave VITE_APP_ENV unset locally (or set to "dev" to preview the environment indicator banner)
# VITE_APP_ENV=
# VITE_OAUTH_ENABLED=true

# Dev / Staging Deployment (Vercel Project: sticky-mind-grid-dev, tracks `dev` branch)
# VITE_API_BASE_URL=https://sticky-mind-grid-api-dev.onrender.com/api
# VITE_APP_ENV=dev
# VITE_OAUTH_ENABLED=false

# Production Deployment (Vercel Project: sticky-mind-grid, tracks `main` branch)
# VITE_API_BASE_URL=https://sticky-mind-grid-api.onrender.com/api
# VITE_APP_ENV=production
# VITE_OAUTH_ENABLED=true
