# Backend Environment Configuration Template

# Flask Secret Key (use a secure random string in production)
SECRET_KEY=change-this-in-production-to-a-random-secret

# Database Connection (MySQL or PostgreSQL)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://root@localhost/sticky_mind_grid

# JWT Secret Key (min 32 characters for security)
JWT_SECRET_KEY=super-secret-jwt-key-for-development-32-chars-long

# Allowed CORS Origins (comma-separated, add your production frontend domain)
# Requests from any other Origin are rejected - this list is enforced strictly.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Maximum upload size in MB (requests above this are rejected with 413)
MAX_UPLOAD_MB=10

# Allowed file extensions for uploads (comma-separated, no dots)
ALLOWED_UPLOAD_EXTENSIONS=png,jpg,jpeg,gif,webp,svg,bmp,ico,pdf,doc,docx,xls,xlsx,ppt,pptx,txt,md,csv,json,rtf,odt,ods,odp,zip,rar,7z,tar,gz,mp4,mov,avi,mkv,webm,mp3,wav,ogg,flac
